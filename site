  <script>
    const termBody = document.getElementById('termBody');
    const termInput = document.getElementById('termInput');

    termInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const cmd = this.value.trim().toLowerCase();
        if(cmd !== "") {
          processCommand(cmd);
        }
        this.value = '';
      }
    });

    function processCommand(cmd) {
      // Adaugă comanda tastată în terminal
      const userLine = document.createElement('div');
      userLine.className = 'terminal-line';
      userLine.innerHTML = `<span class="prompt">user@linux-ro:~$</span> ${cmd}`;
      termBody.appendChild(userLine);

      let responseText = '';
      let color = '#22c55e';

      switch(cmd) {
        case 'help':
          responseText = `Comenzi disponibile:<br>
          - <b>help</b>: Afișează lista de comenzi<br>
          - <b>whoami</b>: Afișează utilizatorul curent<br>
          - <b>date</b>: Arată data și ora curentă<br>
          - <b>ls</b>: Listează directoarele virtuale<br>
          - <b>clear</b>: Curăță ecranul terminalului<br>
          - <b>matrix</b>: Un mic efect vizual cool!`;
          break;
        case 'whoami':
          responseText = 'root_admin (Linux Enthusiast)';
          break;
        case 'date':
          responseText = new Date().toLocaleString('ro-RO');
          break;
        case 'ls':
          responseText = 'Documents/   Downloads/   Desktop/   secret_kernel.sys';
          break;
        case 'clear':
          termBody.innerHTML = '';
          return;
        case 'matrix':
          responseText = '01001100 01001001 01001110 01000101 01011000... System breached! 🟢';
          color = '#00ff00';
          break;
        default:
          responseText = `bash: command not found: ${cmd}. Tastează 'help' pentru instrucțiuni.`;
          color = '#ef4444';
      }

      const responseLine = document.createElement('div');
      responseLine.className = 'terminal-line';
      responseLine.style.color = color;
      responseLine.innerHTML = responseText;
      termBody.appendChild(responseLine);

      // Autoscroll jos
      termBody.scrollTop = termBody.scrollHeight;
    }
  </script>
</body>
</html>
